# =====================================================================
#  Configuração Apache/LiteSpeed (Hostinger)
# =====================================================================

DirectoryIndex index.php
Options -Indexes
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- Forçar HTTPS ------------------------------------------------
    # Ative SOMENTE depois que o SSL estiver ativo no domínio
    # (ou use a opção "Forçar HTTPS" do hPanel). Para ativar, remova o "#"
    # do início das duas linhas abaixo:
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # --- Bloqueia pastas internas e arquivos sensíveis ---------------
    RewriteRule ^(app|config)(/|$) - [F,L]
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
</IfModule>

# Arquivos que nunca devem ser servidos
<FilesMatch "(?i)\.(sql|md|log|ini|sh|bak|dist|sample\.php|lock|json|yml|yaml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Cabeçalhos de segurança
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always unset X-Powered-By
</IfModule>

# Compressão
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json text/plain
</IfModule>

# Cache de arquivos estáticos (CSS/JS usam ?v= para atualizar automaticamente)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# PHP (aplicado quando o servidor permite; também é possível ajustar no hPanel)
<IfModule mod_php.c>
    php_value upload_max_filesize 16M
    php_value post_max_size 64M
    php_flag display_errors Off
</IfModule>
